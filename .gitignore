# ==========================================
# Frontend Client .gitignore
# ==========================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/

# Production build
dist/
dist-ssr/

# Environment files & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
!.env.example
!.env.*.example
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
